# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Required for signing and verifying login tokens.
# Use a cryptographically random value of at least 32 characters.
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TRUST_PROXY: Set to true only when production traffic always passes through one trusted proxy.
TRUST_PROXY="false"

# GCP_PROJECT_ID: Google Cloud Project ID used to invoke Vertex AI
GCP_PROJECT_ID="YOUR_GCP_PROJECT_ID"

# GCP_LOCATION: Google Cloud region for Vertex AI calls (defaults to us-central1)
GCP_LOCATION="us-central1"

# NVIDIA_API_KEY: Optional. NVIDIA NIM API key used as a fallback if Gemini calls fail.
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
